# ---- Režim ----
# PAPER   = skutečné ceny, virtuální peníze (bez API klíčů) – VÝCHOZÍ
# TESTNET = testovací burza Binance (klíče z https://testnet.binance.vision)
# LIVE    = skutečné peníze (vyžaduje I_UNDERSTAND_LIVE_TRADING_RISK=true)
MODE=PAPER
EXCHANGE=binance
SYMBOL=BTC/USDT
TIMEFRAME=1d
HORIZON=1

# ---- Strategie ----
THRESHOLD=0.01            # kupuj, jen když model čeká růst > 1 %
LOOKBACK=256
SAMPLES=5
KRONOS_MODEL=NeoQuasar/Kronos-small
KRONOS_TOKENIZER=NeoQuasar/Kronos-Tokenizer-base

# ---- Riziko ----
POSITION_FRACTION=0.95    # kolik hotovosti použít na nákup
MAX_DRAWDOWN=0.20         # při ztrátě 20 % od startu se bot pozastaví
PAPER_START_BALANCE=1000

# ---- Burza (jen TESTNET / LIVE) ----
# Klíč vytvoř JEN s právem obchodovat (žádné výběry!) a omez ho na IP serveru.
API_KEY=
API_SECRET=

# ---- Telegram ----
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# I_UNDERSTAND_LIVE_TRADING_RISK=false
